#include "ui/menudef.h"
#include "ui_mp/main.inc"
#include "ui_mp/pc_options.inc"
#include "ui_mp/pc_options_gamepad.inc"

#define PC_OPTIONS_ROW_MEM							ui_row_gamepad_triggers

#define MENU_NAME									"pc_options_gamepad_triggers"
#define MENU_TITLE									"@MENU_GPAD_ADV_TRIGGERS"

#undef CHOICE_GROUP
#define CHOICE_GROUP								MENU_NAME

#define ON_MENU_OPEN \
	GPAD_ADV_ON_OPEN \
	close											"pc_options_gamepad_advanced";

#define ON_MENU_CLOSE \
	GPAD_ADV_ON_CLOSE("pc_options_gamepad_advanced")

#define ON_MENU_ESC \
	GPAD_ADV_ON_ESC

#define ON_ADAPTIVE_DISABLED						when(dvarBool("gpad_adaptive_triggers") == 0)

{
	menuDef
	{
		name										MENU_NAME
		rect										0 0 640 480
		foreColor									CHOICE_TEXTCOLOR
		focusColor									CHOICE_TEXTCOLOR
		blurWorld									7

		MENU_ON_OPEN(ON_MENU_OPEN)
		MENU_ON_CLOSE(ON_MENU_CLOSE)
		MENU_ON_ESC(ON_MENU_ESC)

		#define BACKGROUND_PC_OPTIONS
		#define BACKGROUND_IW4
		#define SIDEBAR_RIGHT
		#include "ui_mp/bg.inc"

		#include "ui_mp/leftside_options.inc"

		PC_OPTIONS_SECTION_TITLE(MENU_TITLE)

		GPAD_ADV_SLIDER(0, "@MENU_GPAD_ADV_TRIGGER_DEADZONE", "gpad_button_deadzone", 0, 0.9, 0.13, "@MPUI_DESC_GPAD_ADV_TRIGGER_DEADZONE")
		GPAD_ADV_SLIDER(1, "@MENU_GPAD_ADV_TRIGGER_HYSTERESIS", "gpad_button_deadzone_hysteresis", 0, 0.5, 0.05, "@MPUI_DESC_GPAD_ADV_TRIGGER_HYSTERESIS")

		PC_OPTIONS_SEPERATOR(1)

		GPAD_ADV_YESNO(2, "@MENU_GPAD_ADV_ADAPTIVE", "gpad_adaptive_triggers", "@MPUI_DESC_GPAD_ADV_ADAPTIVE")
		GPAD_ADV_SLIDER_DIS(3, "@MENU_GPAD_ADV_ADAPTIVE_STRENGTH", "gpad_adaptive_trigger_strength", 0, 1, 1, "@MPUI_DESC_GPAD_ADV_ADAPTIVE_STRENGTH", ON_ADAPTIVE_DISABLED)
		GPAD_ADV_LIST_DIS(4, "@MENU_GPAD_ADV_ADAPTIVE_LIGHT", "gpad_adaptive_trigger_light", GPAD_ADV_STEPS_0_8, "@MPUI_DESC_GPAD_ADV_ADAPTIVE_LIGHT", ON_ADAPTIVE_DISABLED)
		GPAD_ADV_LIST_DIS(5, "@MENU_GPAD_ADV_ADAPTIVE_HEAVY", "gpad_adaptive_trigger_heavy", GPAD_ADV_STEPS_0_8, "@MPUI_DESC_GPAD_ADV_ADAPTIVE_HEAVY", ON_ADAPTIVE_DISABLED)

		PC_OPTIONS_SEPERATOR(5)

		GPAD_ADV_LIST_DIS(6, "@MENU_GPAD_ADV_ADAPTIVE_LIGHT_START", "gpad_adaptive_trigger_light_start", GPAD_ADV_STEPS_0_9, "@MPUI_DESC_GPAD_ADV_ADAPTIVE_LIGHT_START", ON_ADAPTIVE_DISABLED)
		GPAD_ADV_LIST_DIS(7, "@MENU_GPAD_ADV_ADAPTIVE_LIGHT_END", "gpad_adaptive_trigger_light_end", GPAD_ADV_STEPS_0_9, "@MPUI_DESC_GPAD_ADV_ADAPTIVE_LIGHT_END", ON_ADAPTIVE_DISABLED)
		GPAD_ADV_LIST_DIS(8, "@MENU_GPAD_ADV_ADAPTIVE_HEAVY_START", "gpad_adaptive_trigger_heavy_start", GPAD_ADV_STEPS_0_9, "@MPUI_DESC_GPAD_ADV_ADAPTIVE_HEAVY_START", ON_ADAPTIVE_DISABLED)
		GPAD_ADV_LIST_DIS(9, "@MENU_GPAD_ADV_ADAPTIVE_HEAVY_END", "gpad_adaptive_trigger_heavy_end", GPAD_ADV_STEPS_0_9, "@MPUI_DESC_GPAD_ADV_ADAPTIVE_HEAVY_END", ON_ADAPTIVE_DISABLED)
		GPAD_ADV_LIST_DIS(10, "@MENU_GPAD_ADV_ADAPTIVE_ADS", "gpad_adaptive_trigger_ads", GPAD_ADV_STEPS_0_8, "@MPUI_DESC_GPAD_ADV_ADAPTIVE_ADS", ON_ADAPTIVE_DISABLED)

		PC_OPTIONS_SEPERATOR(10)

		GPAD_ADV_DEFAULTS(11, GPAD_ADV_RESTORE_TRIGGERS)

		PC_OPTIONS_BUTTON_BACK(ON_MENU_ESC)
	}
}
