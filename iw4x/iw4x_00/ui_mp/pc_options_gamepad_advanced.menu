#include "ui/menudef.h"
#include "ui_mp/main.inc"
#include "ui_mp/pc_options.inc"
#include "ui_mp/pc_options_gamepad.inc"

#define PC_OPTIONS_ROW_MEM							ui_row_gamepad_advanced

#define MENU_NAME									"pc_options_gamepad_advanced"
#define MENU_TITLE									"@MENU_GPAD_ADVANCED"

#undef CHOICE_GROUP
#define CHOICE_GROUP								MENU_NAME

#define ON_MENU_OPEN \
	GPAD_ADV_ON_OPEN \
	close											"pc_options_gamepad";

#define ON_MENU_CLOSE \
	setLocalVarString								ui_hint_text "@NULL_EMPTY"; \
	setLocalVarBool									ui_hint_display 0; \
	execnow											"profile_menuDvarsFinish; resetViewport"; \
	if (!GPAD_ADV_PAGE_OPEN) \
	{ \
		open										"pc_options_gamepad"; \
	}

#define ON_MENU_ESC \
	GPAD_ADV_ON_ESC

#define GPAD_ADV_RESTORE_ALL \
	exec											GPAD_ADV_RESTORE_STICKS; \
	exec											GPAD_ADV_RESTORE_TRIGGERS; \
	exec											GPAD_ADV_RESTORE_RESPONSE; \
	exec											GPAD_ADV_RESTORE_FEEDBACK; \
	exec											GPAD_ADV_RESTORE_TIMING;

{
	menuDef
	{
		name										MENU_NAME
		rect										0 0 640 480
		foreColor									CHOICE_TEXTCOLOR
		focusColor									CHOICE_TEXTCOLOR
		blurWorld									7

		MENU_ON_OPEN(ON_MENU_OPEN)
		MENU_ON_CLOSE(ON_MENU_CLOSE)
		MENU_ON_ESC(ON_MENU_ESC)

		#define BACKGROUND_PC_OPTIONS
		#define BACKGROUND_IW4
		#define SIDEBAR_RIGHT
		#include "ui_mp/bg.inc"

		#include "ui_mp/leftside_options.inc"

		PC_OPTIONS_SECTION_TITLE(MENU_TITLE)

		GPAD_ADV_SUBMENU(0, "buttonSticks", "@MENU_GPAD_ADV_STICKS", "pc_options_gamepad_sticks", "@MPUI_DESC_GPAD_ADV_STICKS")
		GPAD_ADV_SUBMENU(1, "buttonTriggers", "@MENU_GPAD_ADV_TRIGGERS", "pc_options_gamepad_triggers", "@MPUI_DESC_GPAD_ADV_TRIGGERS")
		GPAD_ADV_SUBMENU(2, "buttonResponse", "@MENU_GPAD_ADV_RESPONSE", "pc_options_gamepad_response", "@MPUI_DESC_GPAD_ADV_RESPONSE")
		GPAD_ADV_SUBMENU(3, "buttonFeedback", "@MENU_GPAD_ADV_FEEDBACK", "pc_options_gamepad_feedback", "@MPUI_DESC_GPAD_ADV_FEEDBACK")
		GPAD_ADV_SUBMENU(4, "buttonTiming", "@MENU_GPAD_ADV_TIMING", "pc_options_gamepad_timing", "@MPUI_DESC_GPAD_ADV_TIMING")

		PC_OPTIONS_SEPERATOR(4)

		PC_OPTIONS_BUTTON_RIGHT_RAW(5, "restoreDefaultsAll", "@MENU_GPAD_ADV_DEFAULTS_ALL", GPAD_ADV_RESTORE_ALL, "@MPUI_DESC_GPAD_ADV_DEFAULTS_ALL", when(0), 1)

		PC_OPTIONS_BUTTON_BACK(ON_MENU_ESC)
	}
}
