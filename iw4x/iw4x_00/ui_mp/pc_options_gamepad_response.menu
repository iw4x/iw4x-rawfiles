#include "ui/menudef.h"
#include "ui_mp/main.inc"
#include "ui_mp/pc_options.inc"
#include "ui_mp/pc_options_gamepad.inc"

#define PC_OPTIONS_ROW_MEM							ui_row_gamepad_response

#define MENU_NAME									"pc_options_gamepad_response"
#define MENU_TITLE									"@MENU_GPAD_ADV_RESPONSE"

#undef CHOICE_GROUP
#define CHOICE_GROUP								MENU_NAME

#define ON_MENU_OPEN \
	GPAD_ADV_ON_OPEN \
	close											"pc_options_gamepad_advanced";

#define ON_MENU_CLOSE \
	GPAD_ADV_ON_CLOSE("pc_options_gamepad_advanced")

#define ON_MENU_ESC \
	GPAD_ADV_ON_ESC

#define ON_ACCEL_DISABLED							when(dvarBool("aim_accel_turnrate_enabled") == 0)
#define ON_GRAPH_DISABLED							when(dvarBool("aim_input_graph_enabled") == 0)

{
	menuDef
	{
		name										MENU_NAME
		rect										0 0 640 480
		foreColor									CHOICE_TEXTCOLOR
		focusColor									CHOICE_TEXTCOLOR
		blurWorld									7

		MENU_ON_OPEN(ON_MENU_OPEN)
		MENU_ON_CLOSE(ON_MENU_CLOSE)
		MENU_ON_ESC(ON_MENU_ESC)

		#define BACKGROUND_PC_OPTIONS
		#define BACKGROUND_IW4
		#define SIDEBAR_RIGHT
		#include "ui_mp/bg.inc"

		#include "ui_mp/leftside_options.inc"

		PC_OPTIONS_SECTION_TITLE(MENU_TITLE)

		GPAD_ADV_SLIDER(0, "@MENU_LOOK_SENSITIVITY", "input_viewSensitivity", 0.05, 5, 1, "@MPUI_DESC_GPAD_ADV_SENSITIVITY")

		PC_OPTIONS_SEPERATOR(0)

		GPAD_ADV_SLIDER(1, "@MENU_GPAD_ADV_TURNRATE_YAW", "aim_turnrate_yaw", 0, 1080, 260, "@MPUI_DESC_GPAD_ADV_TURNRATE_YAW")
		GPAD_ADV_SLIDER(2, "@MENU_GPAD_ADV_TURNRATE_PITCH", "aim_turnrate_pitch", 0, 1080, 90, "@MPUI_DESC_GPAD_ADV_TURNRATE_PITCH")
		GPAD_ADV_SLIDER(3, "@MENU_GPAD_ADV_TURNRATE_YAW_ADS", "aim_turnrate_yaw_ads", 0, 1080, 90, "@MPUI_DESC_GPAD_ADV_TURNRATE_YAW_ADS")
		GPAD_ADV_SLIDER(4, "@MENU_GPAD_ADV_TURNRATE_PITCH_ADS", "aim_turnrate_pitch_ads", 0, 1080, 55, "@MPUI_DESC_GPAD_ADV_TURNRATE_PITCH_ADS")

		PC_OPTIONS_SEPERATOR(4)

		GPAD_ADV_YESNO(5, "@MENU_AIM_ACCELERATION", "aim_accel_turnrate_enabled", "@MPUI_DESC_AIM_ACCELERATION")
		GPAD_ADV_SLIDER_DIS(6, "@MENU_GPAD_ADV_ACCEL_RATE", "aim_accel_turnrate_lerp", 0, 4000, 1200, "@MPUI_DESC_GPAD_ADV_ACCEL_RATE", ON_ACCEL_DISABLED)

		PC_OPTIONS_SEPERATOR(6)

		GPAD_ADV_YESNO(7, "@MENU_GPAD_ADV_GRAPH", "aim_input_graph_enabled", "@MPUI_DESC_GPAD_ADV_GRAPH")
		GPAD_ADV_LIST_DIS(8, "@MENU_GPAD_ADV_GRAPH_INDEX", "aim_input_graph_index", GPAD_ADV_STEPS_0_3, "@MPUI_DESC_GPAD_ADV_GRAPH_INDEX", ON_GRAPH_DISABLED)
		GPAD_ADV_YESNO(9, "@MENU_GPAD_ADV_SCALE_VIEW_AXIS", "aim_scale_view_axis", "@MPUI_DESC_GPAD_ADV_SCALE_VIEW_AXIS")

		PC_OPTIONS_SEPERATOR(9)

		GPAD_ADV_YESNO(10, "@MENU_SLOWDOWN_ENABLED", "aim_slowdown_enabled", "@MPUI_DESC_SLOWDOWN_ENABLED")
		GPAD_ADV_YESNO(11, "@MENU_LOCKON_ENABLED", "aim_lockon_enabled", "@MPUI_DESC_LOCKON_ENABLED")

		PC_OPTIONS_SEPERATOR(11)

		GPAD_ADV_DEFAULTS(12, GPAD_ADV_RESTORE_RESPONSE)

		PC_OPTIONS_BUTTON_BACK(ON_MENU_ESC)
	}
}
