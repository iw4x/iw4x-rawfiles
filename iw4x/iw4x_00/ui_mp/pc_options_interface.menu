#include "ui/menudef.h"
#include "ui_mp/main.inc"
#include "ui_mp/pc_options.inc"

#define MENU_NAME									"pc_options_interface"
#define MENU_TITLE									"@MENU_INTERFACE"
#define PC_OPTIONS_ROW_MEM							ui_row_interface

#undef CHOICE_GROUP
#define CHOICE_GROUP								MENU_NAME

#define ON_MENU_OPEN \
	PC_OPTIONS_ON_OPEN

#define ON_MENU_CLOSE \
	PC_OPTIONS_ON_CLOSE

#define ON_MENU_ESC \
	close self; \
	open											"main_options";

{
	menuDef
	{
		name										MENU_NAME
		rect										0 0 640 480
		foreColor									CHOICE_TEXTCOLOR
		focusColor									CHOICE_TEXTCOLOR
		blurWorld									7

		MENU_ON_OPEN(ON_MENU_OPEN)
		MENU_ON_CLOSE(ON_MENU_CLOSE)
		MENU_ON_ESC(ON_MENU_ESC)

		#define BACKGROUND_PC_OPTIONS
		#define BACKGROUND_IW4
		#define SIDEBAR_RIGHT
		#include "ui_mp/bg.inc"

		#include "ui_mp/leftside_options.inc"

		PC_OPTIONS_SECTION_TITLE(MENU_TITLE)

		PC_OPTIONS_DVARYESNO(0, "@MENU_SHOW_BLOOD", "cg_blood", "@MPUI_DESC_SHOW_BLOOD")
		PC_OPTIONS_DVARYESNO(1, "@MENU_COLORBLIND_MODE", "r_colorBlindTeams", "@MPUI_DESC_COLORBLIND_MODE")
		PC_OPTIONS_DVARYESNO(2, "@MENU_NEWCOLORS", "cg_newColors", "@MPUI_DESC_NEWCOLORS")
		PC_OPTIONS_SEPARATOR(2)

		PC_OPTIONS_STRLIST(3, "@MENU_DRAWFPS", "cg_drawFPS",
			{"@MENU_OFF"; "Off";
			"@MENU_FPS_SIMPLE"; "Simple";
			"@MENU_FPS_SIMPLE_RANGES"; "SimpleRanges";
			"@MENU_FPS_VERBOSE"; "Verbose";
			"@MENU_FPS_VERBOSE_VIEWPOS"; "Verbose+Viewpos"}, "@MENU_DESC_DRAWFPS")
		PC_OPTIONS_DVARYESNO_RAW(4, "@MENU_FPSLABELS", "cg_drawFPSLabels", ;, "@MENU_DESC_FPSLABELS", when(dvarString("cg_drawFPS") == "Off"), 1)
		PC_OPTIONS_DVARYESNO(5, "@MENU_LAGOMETER", "drawLagometer", "@MPUI_DESC_LAGOMETER")
		PC_OPTIONS_SEPARATOR(5)

		PC_OPTIONS_DVARYESNO(6, "@MENU_STREAMFRIENDLY_UI", "ui_streamFriendly", "@MPUI_DESC_STREAM_FRIENDLY_UI")
		PC_OPTIONS_DVARYESNO(7, "@MENU_FRIENDNOTIFY", "cl_notifyFriendState", "@MPUI_DESC_FRIENDNOTIFY")
		PC_OPTIONS_BUTTON_BACK(ON_MENU_ESC)
	}
}
