#include "ui/menudef.h"
#include "ui_mp/main.inc"
#include "ui_mp/pc_options.inc"

#define MENU_NAME									"pc_options_network"
#define MENU_TITLE									"@MENU_NETWORK"
#define PC_OPTIONS_ROW_MEM							ui_row_network

#undef CHOICE_GROUP
#define CHOICE_GROUP								MENU_NAME

#define ON_MENU_OPEN \
	PC_OPTIONS_ON_OPEN

#define ON_MENU_CLOSE \
	PC_OPTIONS_ON_CLOSE \
	open											"pc_options_multi";

#define ON_MENU_ESC \
	close self;

{
	menuDef
	{
		name										MENU_NAME
		rect										0 0 640 480
		foreColor									CHOICE_TEXTCOLOR
		focusColor									CHOICE_TEXTCOLOR
		blurWorld									7

		MENU_ON_OPEN(ON_MENU_OPEN)
		MENU_ON_CLOSE(ON_MENU_CLOSE)
		MENU_ON_ESC(ON_MENU_ESC)

		#define BACKGROUND_PC_OPTIONS
		#define BACKGROUND_IW4
		#define SIDEBAR_RIGHT
		#include "ui_mp/bg.inc"

		PC_OPTIONS_SECTION_TITLE(MENU_TITLE)

		PC_OPTIONS_FLOATLIST(0, "@MENU_MAXPACKETS", "cl_maxpackets", {"30" 30 "100 (Default)" 100 "125" 125}, "@MENU_DESC_MAXPACKETS")
		PC_OPTIONS_FLOATLIST(1, "@MENU_SNAPS", "snaps", {"20 (Default)" 20 "30" 30}, "@MENU_DESC_SNAPS")
		PC_OPTIONS_BUTTON_BACK(ON_MENU_ESC)
	}
}
