#include "ui/menudef.h"
#include "ui_mp/main.inc"

#define HIDE_MOD

#define MENU_NAME													"pc_join_unranked"
#define MENU_MUSIC													"music_mainmenu_mp"
#define MENU_TITLE													"@MENU_JOIN_SERVER_CAP"

#undef CHOICE_GROUP
#define CHOICE_GROUP												MENU_NAME

#define ON_MENU_OPEN \
	exec															"selectStringTableEntryInDvar mp/didyouknow.csv 0 didyouknow"; \
	uiScript														"LoadArenas"; \
	uiScript														"UpdateFilter"; \
	uiScript														"RefreshServers"; \
	setFocus														"serverlist";

#define KEYINT_F5													171
#define KEYINT_ENTER												13

#define ON_MENU_ESC \
	close															self;

#define ON_MENU_KEY_F5 \
	uiScript														"RefreshServers";

#define ON_MENU_KEY_ENTER \
	uiScript														"JoinServer";

{
	menuDef
	{
		name															MENU_NAME
		fullscreen														1
		rect															0 0 640 480
		foreColor														CHOICE_TEXTCOLOR
		focusColor														CHOICE_TEXTCOLOR
		soundLoop														MENU_MUSIC
		fadeCycle														1
		fadeClamp														1
		fadeAmount														0.1

		MENU_ON_OPEN(ON_MENU_OPEN)
		MENU_ON_ESC(ON_MENU_ESC)

		MENU_EXEC_KEYINT(KEYINT_F5, ON_MENU_KEY_F5)
		MENU_EXEC_KEYINT(KEYINT_ENTER, ON_MENU_KEY_ENTER)

		#define DISABLE_SIDEBAR
		#include "ui_mp/bg.inc"

		#include "ui_mp/joinserver.inc"

		ITEM_MENU_TITLE_VIS(MENU_TITLE, 1)

		// The footer buttons sit side by side with their text centered, so a
		// label wider than its slot runs into the next one. The slots are
		// sized for the longest translation of each label, not the English
		// one, and together span most of a 16:9 screen.
		//
		BUTTON_FOOTER(-383, 110, "back", "@PLATFORM_BACK_CAPS", ON_MENU_ESC)
		BUTTON_FOOTER(-273, 70, "filtername", "@MENU_FILTER_CAPS", open "popup_servername_filter";)
		BUTTON_FOOTER_VIS(-203, 150, "addFavorite", "@MENU_ADD_TO_FAVORITES_CAPS", uiScript "CreateListFavorite", when(dvarInt("ui_netSource") != 2))
		BUTTON_FOOTER_VIS(-203, 150, "delFavorite", "@MENU_DEL_FAVORITE_CAPS", uiScript "DeleteFavorite", when(dvarInt("ui_netSource") == 2))
		BUTTON_FOOTER(-53, 100, "passwordenter", "@MENU_PASSWORD_CAPS", open "popup_joinpassword";)
		BUTTON_FOOTER(47, 105, "serverinfo", "@MENU_SERVER_INFO_CAPS", open "serverinfo_popmenu";)
		BUTTON_FOOTER(152, 100, "loadmod", "@MENU_LOAD_MOD_CAPS", uiScript "DownloadServerMod";)
		BUTTON_FOOTER(252, 130, "joinserver", "@MENU_JOIN_SERVER_CAP", uiScript "JoinServer";)
	}
}
