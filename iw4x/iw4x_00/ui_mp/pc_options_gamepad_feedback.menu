#include "ui/menudef.h"
#include "ui_mp/main.inc"
#include "ui_mp/pc_options.inc"
#include "ui_mp/pc_options_gamepad.inc"

#define PC_OPTIONS_ROW_MEM							ui_row_gamepad_feedback

#define MENU_NAME									"pc_options_gamepad_feedback"
#define MENU_TITLE									"@MENU_GPAD_ADV_FEEDBACK"

#undef CHOICE_GROUP
#define CHOICE_GROUP								MENU_NAME

#define ON_MENU_OPEN \
	GPAD_ADV_ON_OPEN \
	close											"pc_options_gamepad_advanced";

#define ON_MENU_CLOSE \
	GPAD_ADV_ON_CLOSE("pc_options_gamepad_advanced")

#define ON_MENU_ESC \
	GPAD_ADV_ON_ESC

#define ON_RUMBLE_DISABLED							when(dvarBool("gpad_rumble") == 0)
#define ON_HAPTICS_DISABLED							when(dvarBool("gpad_rumble") == 0 || dvarBool("gpad_haptics") == 0)
#define ON_LIGHT_BAR_DISABLED						when(dvarBool("gpad_light_bar") == 0)

{
	menuDef
	{
		name										MENU_NAME
		rect										0 0 640 480
		foreColor									CHOICE_TEXTCOLOR
		focusColor									CHOICE_TEXTCOLOR
		blurWorld									7

		MENU_ON_OPEN(ON_MENU_OPEN)
		MENU_ON_CLOSE(ON_MENU_CLOSE)
		MENU_ON_ESC(ON_MENU_ESC)

		#define BACKGROUND_PC_OPTIONS
		#define BACKGROUND_IW4
		#define SIDEBAR_RIGHT
		#include "ui_mp/bg.inc"

		#include "ui_mp/leftside_options.inc"

		PC_OPTIONS_SECTION_TITLE(MENU_TITLE)

		GPAD_ADV_YESNO(0, "@MENU_GPAD_RUMBLE", "gpad_rumble", "@MENU_GPAD_RUMBLE")
		GPAD_ADV_SLIDER_DIS(1, "@MENU_GPAD_ADV_RUMBLE_LOW", "gpad_rumble_scale_low", 0, 1, 1, "@MPUI_DESC_GPAD_ADV_RUMBLE_LOW", ON_RUMBLE_DISABLED)
		GPAD_ADV_SLIDER_DIS(2, "@MENU_GPAD_ADV_RUMBLE_HIGH", "gpad_rumble_scale_high", 0, 1, 1, "@MPUI_DESC_GPAD_ADV_RUMBLE_HIGH", ON_RUMBLE_DISABLED)

		PC_OPTIONS_SEPERATOR(2)

		GPAD_ADV_YESNO_DIS(3, "@MENU_GPAD_FORCE_FEEDBACK", "gpad_haptics", "@MPUI_DESC_GPAD_ADV_HAPTICS", ON_RUMBLE_DISABLED)
		GPAD_ADV_SLIDER_DIS(4, "@MENU_GPAD_ADV_HAPTIC_INTENSITY", "gpad_haptic_intensity", 0, 1, 1, "@MPUI_DESC_GPAD_ADV_HAPTIC_INTENSITY", ON_HAPTICS_DISABLED)
		GPAD_ADV_LIST_DIS(5, "@MENU_GPAD_ADV_OUTPUT_INTERVAL", "gpad_output_interval", GPAD_ADV_STEPS_INTERVAL, "@MPUI_DESC_GPAD_ADV_OUTPUT_INTERVAL", ON_RUMBLE_DISABLED)

		PC_OPTIONS_SEPERATOR(5)

		GPAD_ADV_YESNO(6, "@MENU_GPAD_ADV_LIGHT_BAR", "gpad_light_bar", "@MPUI_DESC_GPAD_ADV_LIGHT_BAR")
		GPAD_ADV_SLIDER_DIS(7, "@MENU_GPAD_ADV_LIGHT_BRIGHTNESS", "gpad_light_bar_brightness", 0, 1, 1, "@MPUI_DESC_GPAD_ADV_LIGHT_BRIGHTNESS", ON_LIGHT_BAR_DISABLED)
		GPAD_ADV_SLIDER_DIS(8, "@MENU_GPAD_ADV_LIGHT_RED", "gpad_light_bar_r", 0, 255, 196, "@MPUI_DESC_GPAD_ADV_LIGHT_RED", ON_LIGHT_BAR_DISABLED)
		GPAD_ADV_SLIDER_DIS(9, "@MENU_GPAD_ADV_LIGHT_GREEN", "gpad_light_bar_g", 0, 255, 151, "@MPUI_DESC_GPAD_ADV_LIGHT_GREEN", ON_LIGHT_BAR_DISABLED)
		GPAD_ADV_SLIDER_DIS(10, "@MENU_GPAD_ADV_LIGHT_BLUE", "gpad_light_bar_b", 0, 255, 54, "@MPUI_DESC_GPAD_ADV_LIGHT_BLUE", ON_LIGHT_BAR_DISABLED)

		PC_OPTIONS_SEPERATOR(10)

		PC_OPTIONS_BUTTON_RIGHT_RAW(11, "testHaptic", "@MENU_GPAD_ADV_TEST_RUMBLE", exec "controller_haptic 1 0.5 0.35";, "@MPUI_DESC_GPAD_ADV_TEST_RUMBLE", ON_RUMBLE_DISABLED, 1)
		GPAD_ADV_DEFAULTS(12, GPAD_ADV_RESTORE_FEEDBACK)

		PC_OPTIONS_BUTTON_BACK(ON_MENU_ESC)
	}
}
